        "envs/repeatmasker.yaml"
    shell:
        """
        mkdir -p $(dirname {output.curated})
        famdb.py \
            -i {params.famdb_dir:q} \
            families -c -a -d -f fasta_name --include-class-in-name \
            {params.taxon:q} > {output.curated:q}

        if [[ ! -s {output.curated:q} ]]; then
            echo "ERROR: FamDB exported no curated families for {params.taxon}" >&2
            exit 1
        fi
        """

# ============================================================================
# MERGE DE NOVO + LTR
# ============================================================================

def merge_ltr_input(wildcards):
    if config.get("run_ltr_retriever", False):
        return rules.ltr_retriever.output.ltr_lib
    return []

rule merge_ltr:
    input:
        denovo = rules.classify_filter.output.filtered,
        ltr    = merge_ltr_input
    output:
        merged = f"{OUTDIR}/02_library/denovo_plus_ltr.fa"
    resources:
        **slurm_res("light")
    run:
        import shutil
        Path(output.merged).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(input.denovo, output.merged)
        if config.get("run_ltr_retriever", False):
            ltr_path = str(input.ltr)
        if config.get("run_ltr_retriever", False) and os.path.getsize(ltr_path) > 0:
            with open(output.merged, "a") as out_f:
                with open(ltr_path) as in_f:
                    out_f.write(in_f.read())

# ============================================================================
# CD-HIT: REMOVE DE NOVO MATCHING CURATED
# ============================================================================

rule cdhit_2d:
    input:
        curated = rules.export_dfam.output.curated,
        denovo  = rules.merge_ltr.output.merged
    output:
        filtered = f"{OUTDIR}/02_library/{DB_NAME}_not_in_curated.fa"
    params:
        identity = config["cdhit_identity_2d"],
        coverage = config["cdhit_coverage_2d"],
        word     = cdhit_est_word_size(config["cdhit_identity_2d"]),
        mem      = int(config["resources"]["cdhit"]["mem_gb"] * 1024 * 0.9)
    threads: config["resources"]["cdhit"]["threads"]
    resources:
        **slurm_res("cdhit")
    conda:
        "envs/repeatmasker.yaml"
    shell:
        """
        cd-hit-est-2d \
            -i {input.curated} \
            -i2 {input.denovo} \
            -o {output.filtered} \
            -c {params.identity} \
            -n {params.word} \
            -G 1 \
            -aS {params.coverage} \
            -s2 0.0 \
            -r 1 \
            -g 1 \
            -d 0 \
            -T {threads} \
            -M {params.mem}
        """

# ============================================================================
# CD-HIT: SELF-CLUSTERING DE NOVO
# ============================================================================

rule cdhit_self:
    input:
        rules.cdhit_2d.output.filtered
    output:
        nr = f"{OUTDIR}/02_library/{DB_NAME}_not_in_curated_nr.fa"
    params:
        identity = config["cdhit_identity_self"],
        coverage = config["cdhit_coverage_self"],
        word     = cdhit_est_word_size(config["cdhit_identity_self"]),
        mem      = int(config["resources"]["cdhit"]["mem_gb"] * 1024 * 0.9)
    threads: config["resources"]["cdhit"]["threads"]
    resources:
        **slurm_res("cdhit")
    conda:
        "envs/repeatmasker.yaml"
    shell:
        """
        cd-hit-est \
            -i {input} \
            -o {output.nr} \
            -c {params.identity} \
            -n {params.word} \
            -G 1 \
            -aS {params.coverage} \
            -r 1 \
            -g 1 \
            -d 0 \
            -T {threads} \
            -M {params.mem}
        """

# ============================================================================
# COMBINE FINAL LIBRARY
# ============================================================================

rule combine_library:
    input:
        curated = rules.export_dfam.output.curated,
        denovo  = rules.cdhit_self.output.nr
    output:
        combined  = f"{OUTDIR}/02_library/{FINAL_LIBRARY_NAME}",
        dup_check = f"{OUTDIR}/02_library/duplicate_family_names_after_cdhit.txt"
    resources:
        **slurm_res("light")
    shell:
        """
        cat {input.curated} {input.denovo} > {output.combined}
        grep '^>' {output.combined} | sed 's/^>//; s/#.*//' | sort | uniq -d > {output.dup_check}
        [[ -s {output.dup_check} ]] && {{ echo "ERROR: duplicate names"; cat {output.dup_check}; exit 1; }} || true
        """

