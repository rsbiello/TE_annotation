    params:
        odir      = f"{OUTDIR}/03_repeatmasker_final",
        famdb     = config["famdb_dir"],
        pa        = lambda wc, threads: max(1, threads // 4)
    threads: config["resources"]["repeatmasker"]["threads"]
    resources:
        **slurm_res("repeatmasker")
    conda:
        "envs/repeatmasker.yaml"
    shell:
        """
        mkdir -p {params.odir}
        RepeatMasker \
            -gff -s -xsmall -align \
            -pa {params.pa} \
            -famdb_dir {params.famdb} \
            -lib {input.library} \
            -dir {params.odir} \
            {input.genome}
        """

# ============================================================================
# 04A TANDEM REPEATS FINDER: SCATTER/GATHER (optional)
# ============================================================================

checkpoint split_genome_for_trf:
    input:
        genome = GENOME
    output:
        chunks = directory(f"{TRF_ROOT}/chunks"),
        manifest = f"{TRF_ROOT}/manifest.tsv"
    params:
        chunk_count = TRF_CHUNKS
    threads: TRF_THREADS
    resources:
        **slurm_res("light")
    script:
        "scripts/split_fasta.py"


def trf_chunk_fasta(wildcards):
    completed = checkpoints.split_genome_for_trf.get()
    return os.path.join(str(completed.output.chunks), f"{wildcards.chunk}.fa")


def trf_chunk_beds(wildcards):
    completed = checkpoints.split_genome_for_trf.get()
    beds = []
    with open(str(completed.output.manifest), encoding="utf-8") as handle:
        header = next(handle, "").rstrip("\n").split("\t")
        if header != ["chunk", "sequence_count", "total_bases", "fasta"]:
            raise ValueError("Invalid TRF chunk manifest header")
        for line in handle:
            if line.strip():
                chunk = line.split("\t", 1)[0]
                beds.append(f"{TRF_ROOT}/bed/{chunk}.bed")
    if not beds:
        raise ValueError("TRF chunk manifest contains no chunks")
    return beds


rule trf_chunk:
    input:
        fasta = trf_chunk_fasta
    output:
        bed = f"{TRF_ROOT}/bed/{{chunk}}.bed"
    params:
        tmp_parent = f"{TRF_ROOT}/tmp",
        match = int(TRF_CONFIG.get("match", 2)),
        mismatch = int(TRF_CONFIG.get("mismatch", 5)),
        delta = int(TRF_CONFIG.get("delta", 7)),
        pm = int(TRF_CONFIG.get("pm", 80)),
        pi = int(TRF_CONFIG.get("pi", 10)),
        minscore = int(TRF_CONFIG.get("minscore", 50)),
        maxperiod = int(TRF_CONFIG.get("maxperiod", 2000))
    threads: TRF_THREADS
    resources:
        **slurm_res("trf")
    conda:
        "envs/trf.yaml"
    shell:
        """
        FASTA=$(readlink -f {input.fasta})
        BED=$(readlink -m {output.bed})
        TMP_PARENT=$(readlink -m {params.tmp_parent})
        mkdir -p "$TMP_PARENT" "$(dirname "$BED")"

        TRF_WORK=$(mktemp -d "$TMP_PARENT/{wildcards.chunk}.XXXXXX")
        trap 'rm -rf "$TRF_WORK"' EXIT
        cd "$TRF_WORK"

        trf "$FASTA" \
            {params.match} {params.mismatch} {params.delta} \
            {params.pm} {params.pi} {params.minscore} {params.maxperiod} \
            -d -h

        DAT=$(find "$TRF_WORK" -maxdepth 1 -type f -name '*.dat' -print -quit)
        if [[ -z "$DAT" || ! -f "$DAT" ]]; then
            echo "ERROR: TRF completed without producing a .dat file for {wildcards.chunk}" >&2
            exit 1
        fi

        awk '/^Sequence:/ {{seq=$2}} /^[0-9]/ {{
            print seq"\t"$1-1"\t"$2"\tTRF_period_"$3"\t0\t."
        }}' "$DAT" > "$BED"
        """


rule merge_trf:
    input:
        beds = trf_chunk_beds
    output:
        bed = f"{OUTDIR}/04_postprocess/tandem_repeats.bed"
    resources:
        **slurm_res("postprocess")
    shell:
        """
        mkdir -p $(dirname {output.bed})
        LC_ALL=C sort -k1,1 -k2,2n {input.beds:q} > {output.bed}
        """

# ============================================================================
# 04B REPEATMASKER TO BED
# ============================================================================

rule rm_to_bed:
    input:
        rules.repeatmasker.output.out
    output:
        bed = f"{OUTDIR}/04_postprocess/repeats.bed"
    resources:
        **slurm_res("postprocess")
    shell:
        """
        mkdir -p $(dirname {output.bed})
        awk 'NR>3 && $0 !~ /^#/ && NF>=15 {{
            chr=$5; start=$6; end=$7; strand=$9; class=$11; family=$10;
            if (strand=="C") strand="-";
            print chr"\t"start-1"\t"end"\t"family"#"class"\t0\t"strand
        }}' {input} | sort -k1,1 -k2,2n > {output.bed}
        """

# ============================================================================
# 04C TE CLASS SUMMARY
# ============================================================================

rule te_summary:
    input:
        rm_out = rules.repeatmasker.output.out,
        genome = GENOME
    output:
        summary = f"{OUTDIR}/04_postprocess/te_summary_by_class.tsv"
    resources:
        **slurm_res("postprocess")
    shell:
        """
        mkdir -p $(dirname {output.summary})
        GENOME_SIZE=$(grep -v '^>' {input.genome} | tr -d '\n' | wc -c)
        printf 'Class\tTotal_bp\tHit_count\tPercent_genome\n' > {output.summary}
        awk -v gs="$GENOME_SIZE" 'NR>3 && $0 !~ /^#/ && NF>=15 {{
            split($11, a, "/"); class=a[1]; if (class=="") class="Unknown";
            len=$7-$6+1; total[class]+=len; count[class]++
        }}
        END {{
            for (c in total) print c"\t"total[c]"\t"count[c]"\t"(total[c]/gs)*100
        }}' {input.rm_out} | sort -k2,2nr >> {output.summary}
        """

# ============================================================================
# 04D TE LANDSCAPE (optional)
# ============================================================================

rule landscape:
    input:
        align  = rules.repeatmasker.output.align,
        genome = GENOME
    output:
        html = f"{OUTDIR}/04_postprocess/repeat_landscape.html"
    threads: 1
    resources:
        **slurm_res("postprocess")
    conda:
        "envs/repeatmasker.yaml"
    shell:
        """
        mkdir -p $(dirname {output.html})
        GENOME_SIZE=$(grep -v '^>' {input.genome} | tr -d '\n' | wc -c)
        calcDivergenceFromAlign.pl \
            -s {output.html}.divsum \
            {input.align}
        createRepeatLandscape.pl \
            -div {output.html}.divsum \
            -g $GENOME_SIZE \
            > {output.html}
        """
