# FINAL TARGETS
# ============================================================================

FINAL = [
    f"{OUTDIR}/03_repeatmasker_final/{GENOME_NAME}.masked",
    f"{OUTDIR}/04_postprocess/repeats.bed",
    f"{OUTDIR}/04_postprocess/te_summary_by_class.tsv",
]

if config.get("run_trf", False):
    FINAL.append(f"{OUTDIR}/04_postprocess/tandem_repeats.bed")

if config.get("generate_landscape", False):
    FINAL.append(f"{OUTDIR}/04_postprocess/repeat_landscape.html")

rule all:
    input:
        FINAL

# ============================================================================
# 00 INPUT DATABASE VALIDATION
# ============================================================================

rule validate_famdb:
    output:
        ok = f"{OUTDIR}/00_preflight/famdb.ok"
    params:
        famdb_dir = config["famdb_dir"],
        taxon     = TAXON
    resources:
        **slurm_res("light")
    conda:
        "envs/repeatmasker.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.ok:q})

        FAMDB_INFO=$(famdb.py -i {params.famdb_dir:q} info)
        printf '%s\n' "$FAMDB_INFO"

        CONSENSUS_COUNT=$(printf '%s\n' "$FAMDB_INFO" | \
            awk -F: '/Total consensus sequences present/ {{gsub(/[^0-9]/, "", $2); print $2; exit}}')
        if [[ ! "$CONSENSUS_COUNT" =~ ^[0-9]+$ ]] || (( CONSENSUS_COUNT < 26200 )); then
            echo "ERROR: RepeatModeler 2.0.9 requires a complete curated-consensus FamDB dataset." >&2
            echo "Found only ${{CONSENSUS_COUNT:-0}} consensus sequences in {params.famdb_dir}." >&2
            exit 1
        fi

        REPEATPEPS_COUNT=$(famdb.py -i {params.famdb_dir:q} repeat_peps | \
            grep -c '^>' || true)
        if (( REPEATPEPS_COUNT == 0 )); then
            echo "ERROR: the FamDB root file contains no RepeatPeps protein library." >&2
            exit 1
        fi

        famdb.py -i {params.famdb_dir:q} names {params.taxon:q}
        famdb.py -i {params.famdb_dir:q} check --component cc {params.taxon:q}
        touch {output.ok:q}
        """

# ============================================================================
# 01 DE NOVO DISCOVERY (RepeatModeler via Conda)
# ============================================================================

rule repeatmodeler:
    input:
        genome = GENOME,
        famdb_ok = rules.validate_famdb.output.ok
    output:
        families = f"{OUTDIR}/01_repeatmodeler/{DB_NAME}-families.fa"
    params:
        db         = DB_NAME,
        odir       = f"{OUTDIR}/01_repeatmodeler",
        famdb_data = config["famdb_dir"],
        ltr_option = REPEATMODELER_LTR_OPTION
    threads: config["resources"]["repeatmodeler"]["threads"]
    resources:
        **slurm_res("repeatmodeler")
    conda:
        "envs/repeatmodeler.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.odir:q}

        GENOME_ABS=$(readlink -f {input.genome:q})
        OUT_ABS=$(readlink -f {params.odir:q})
        FAMDB_DATA_ABS=$(readlink -f {params.famdb_data:q})
        FAMDB_EXE=$(command -v famdb.py || true)

        if [[ -z "$FAMDB_EXE" ]]; then
            echo "ERROR: the Conda RepeatModeler environment has no famdb.py" >&2
            exit 1
        fi

        # RepeatModeler expects FAMDB_DIR to contain famdb.py, whereas this
        # workflow keeps the large Dfam .h5 files outside the Conda environment.
        # A job-local wrapper connects the Conda executable to those data files
        # without modifying the shared, content-addressed Snakemake environment.
        FAMDB_WRAPPER_DIR="$OUT_ABS/.famdb-wrapper"
        mkdir -p "$FAMDB_WRAPPER_DIR"
        printf '#!/usr/bin/env bash\nexec %q -i %q "$@"\n' \
            "$FAMDB_EXE" "$FAMDB_DATA_ABS" \
            > "$FAMDB_WRAPPER_DIR/famdb.py"
        chmod 0755 "$FAMDB_WRAPPER_DIR/famdb.py"

        export BLAST_USAGE_REPORT=false
        RepeatMasker -v
        RepeatModeler -version

        cd "$OUT_ABS"
        BuildDatabase -name {params.db:q} "$GENOME_ABS"
        RepeatModeler \
            -database {params.db:q} \
            -threads {threads} \
            -famdb_dir "$FAMDB_WRAPPER_DIR" \
            {params.ltr_option}
        """

# ============================================================================
# 01B CLASSIFY & FILTER ARTIFACTS
# ============================================================================

rule classify_filter:
    input:
        families = rules.repeatmodeler.output.families,
        protein_db = config["protein_db"]
    output:
        filtered = f"{OUTDIR}/01b_classified_filtered/{DB_NAME}-families.classified.filtered.fa",
        report   = f"{OUTDIR}/01b_classified_filtered/removed_artifacts.tsv"
    params:
        odir       = f"{OUTDIR}/01b_classified_filtered"
    threads: config["resources"]["classify_filter"]["threads"]
    resources:
        **slurm_res("classify_filter")
    conda:
        "envs/repeatmasker.yaml"
    shell:
        """
        mkdir -p {params.odir}

        # RepeatModeler produces an already classified families library. Avoid
        # reclassifying it in a separate environment with a potentially
        # incomplete RepeatMasker/Dfam installation.
        CLASSIFIED={input.families}

        # BLASTx vs proteins
        makeblastdb -in {input.protein_db} -dbtype prot -out {params.odir}/protdb -parse_seqids
        blastx -query $CLASSIFIED \
            -db {params.odir}/protdb \
            -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore stitle" \
            -evalue 1e-10 -num_threads {threads} \
            -out {params.odir}/blastx_vs_proteins.tsv

        # Filter artifacts
        python workflow/scripts/filter_artifacts.py \
            --input $CLASSIFIED \
            --blast {params.odir}/blastx_vs_proteins.tsv \
            --output {output.filtered} \
            --report {output.report}
        """

# ============================================================================
# 02B LTR CANDIDATE DISCOVERY + LTR_RETRIEVER (optional)
# ============================================================================

rule ltr_retriever:
    input:
        genome = GENOME
    output:
        ltr_lib = f"{OUTDIR}/02b_ltr_retriever/LTRlib.fa"
    params:
        odir = f"{OUTDIR}/02b_ltr_retriever"
    threads: config["resources"]["ltr_retriever"]["threads"]
    resources:
        **slurm_res("ltr_retriever")
    conda:
        "envs/ltr_retriever.yaml"
    shell:
        """
        mkdir -p {params.odir}
        cd {params.odir}

        GENOME_ABS=$(readlink -f {input.genome})
        GENOME_LOCAL=$(basename "$GENOME_ABS")
        ln -sf "$GENOME_ABS" "$GENOME_LOCAL"

        # LTR_retriever requires candidate calls. Generate candidates with both
        # tools recommended by the LTR_retriever authors.
        gt suffixerator \
            -db "$GENOME_LOCAL" \
            -indexname "$GENOME_LOCAL" \
            -tis -suf -lcp -des -ssp -sds -dna

        gt ltrharvest \
            -index "$GENOME_LOCAL" \
            -minlenltr 100 -maxlenltr 7000 \
            -mintsd 4 -maxtsd 6 \
            -motif TGCA -motifmis 1 \
            -similar 85 -vic 10 -seed 20 \
            -seqids yes \
            > "$GENOME_LOCAL.harvest.scn"

        LTR_FINDER_parallel \
            -seq "$GENOME_LOCAL" \
            -threads {threads} \
            -harvest_out \
            -size 1000000 \
            -time 300

        cat \
            "$GENOME_LOCAL.harvest.scn" \
            "$GENOME_LOCAL.finder.combine.scn" \
            > "$GENOME_LOCAL.rawLTR.scn"

        # An empty library is legitimate only when both discovery methods find
        # no candidates. Program failures still terminate the rule.
        if [[ ! -s "$GENOME_LOCAL.rawLTR.scn" ]]; then
            : > {output.ltr_lib}
            exit 0
        fi

        LTR_retriever \
            -genome "$GENOME_LOCAL" \
            -inharvest "$GENOME_LOCAL.rawLTR.scn" \
            -threads {threads}

        # Recent versions may encode sequence names and insert '.mod' into the
        # output name, so locate the non-nmtf library explicitly.
        LTR_LIB=$(find . -maxdepth 1 -type f \
            -name "$GENOME_LOCAL*.LTRlib.fa" \
            ! -name "*.nmtf.LTRlib.fa" \
            -print -quit)

        if [[ -z "$LTR_LIB" || ! -s "$LTR_LIB" ]]; then
            echo "ERROR: LTR_retriever did not produce a nonempty LTR library" >&2
            exit 1
        fi

        cp "$LTR_LIB" {output.ltr_lib}
        """

