import os
import re
from pathlib import Path

# ============================================================================
# HELPERS
# ============================================================================

def slurm_res(key):
    cfg = config["resources"][key]
    resources = {
        "mem_mb":    cfg["mem_gb"] * 1024,
        "walltime":  cfg["time"],
        "partition": cfg["partition"],
    }
    # Optional site-specific constraint. The public SLURM profile does not
    # require this, while a local cluster configuration may set a node list.
    if cfg.get("nodelist"):
        resources["nodelist"] = cfg["nodelist"]
    return resources


def safe_name(value):
    return re.sub(r"[^A-Za-z0-9._-]+", "_", value).strip("_")


def cdhit_est_word_size(identity):
    if identity >= 0.90:
        return 8
    if identity >= 0.88:
        return 7
    if identity >= 0.85:
        return 6
    if identity >= 0.80:
        return 5
    if identity >= 0.75:
        return 4
    raise ValueError("CD-HIT-EST identity must be at least 0.75")

# ============================================================================
# GLOBALS
# ============================================================================

GENOME      = config["genome"]
# RepeatMasker appends its suffixes to the complete input filename (including
# .fa/.fasta), e.g. genome.fa.out and genome.fa.masked.
GENOME_NAME = Path(GENOME).name
DB_NAME     = config["database_name"]
OUTDIR      = config["output_dir"]
TAXON       = config["taxon"]
SPECIES     = config.get("species_name", Path(GENOME).stem)
TAXON_NAME  = safe_name(TAXON)
SPECIES_NAME = safe_name(SPECIES)
FINAL_LIBRARY_NAME = config.get(
    "final_library_name",
    f"{SPECIES_NAME}_combined_curated_{TAXON_NAME}.fa",
)
REPEATMODELER_LTR_OPTION = (
    "-LTRStruct" if config.get("repeatmodeler_ltr_struct", True) else ""
)

TRF_ROOT = f"{OUTDIR}/04_postprocess/trf"
TRF_CHUNKS = int(config.get("trf_chunks", 32))
TRF_CONFIG = config.get("trf_parameters", {})
TRF_THREADS = int(config["resources"]["trf"].get("threads", 1))
if not 1 <= TRF_CHUNKS <= 256:
    raise ValueError("trf_chunks must be between 1 and 256")
if TRF_THREADS != 1:
    raise ValueError(
        "resources.trf.threads must be 1 because TRF parallelism uses chunks"
    )

localrules: all

